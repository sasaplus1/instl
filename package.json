{
  "name": "instl",
  "description": "A CLI tool for installing files with LTSV recipe support",
  "version": "1.0.0",
  "author": "sasa+1 <sasaplus1@gmail.com>",
  "bin": {
    "instl": "dist/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ltsv": "^3.0.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "cli",
    "file-management",
    "install",
    "ltsv"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node --packages external",
    "typecheck": "tsc",
    "dev": "tsx src/index.ts",
    "test": "node --test --test-timeout=30000 --import tsx test/e2e/*.test.ts"
  },
  "type": "module"
}
