{
  "name": "instl",
  "description": "A CLI tool for installing files with LTSV recipe support",
  "version": "1.0.0",
  "author": "sasa+1 <sasaplus1@gmail.com>",
  "bin": {
    "instl": "dist/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ltsv": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "cli",
    "file-management",
    "install",
    "ltsv"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node --packages external",
    "dev": "bun src/index.ts",
    "lint": "pnpm run lint:biome && pnpm run lint:tsc",
    "lint:biome": "biome check .",
    "lint:tsc": "tsc",
    "fix": "pnpm run fix:biome",
    "fix:biome": "biome check --write .",
    "test": "pnpm run test:node && pnpm run test:bun",
    "test:bun": "bun test test/e2e/*.test.ts",
    "test:node": "node --test --test-timeout=30000 --import tsx test/e2e/*.test.ts"
  },
  "type": "module"
}
