{
  "name": "instl",
  "description": "A CLI tool for installing files with LTSV recipe support",
  "version": "0.1.0",
  "author": "sasa+1 <sasaplus1@gmail.com>",
  "bin": {
    "instl": "dist/index.js"
  },
  "dependencies": {
    "commander": "12.1.0",
    "ltsv": "3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.0.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "24"
  },
  "files": [
    "dist/index.js",
    "dist/THIRD_PARTY_LICENSES.txt"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sasaplus1/instl.git"
  },
  "scripts": {
    "build": "pnpm run build:script && pnpm run build:binary",
    "build:binary": "bun build src/index.ts --compile --outfile dist/instl",
    "build:script": "bun build src/index.ts --outfile dist/index.js --target node --packages external",
    "dev": "bun src/index.ts",
    "fix": "pnpm run fix:biome",
    "fix:biome": "biome check --write .",
    "generate": "pnpm run generate:licenses",
    "generate:licenses": "license-checker-rseidelsohn --production --plainVertical --excludePackages instl --out dist/THIRD_PARTY_LICENSES.txt",
    "lint": "pnpm run lint:biome && pnpm run lint:tsc",
    "lint:biome": "biome check .",
    "lint:tsc": "tsc",
    "test": "pnpm run test:node && pnpm run test:bun",
    "test:bun": "bun test test/e2e/*.test.ts",
    "test:node": "node --test --test-timeout=30000 --import tsx test/e2e/*.test.ts"
  },
  "type": "module"
}
